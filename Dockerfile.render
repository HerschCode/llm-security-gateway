# Gateway image for the Render free tier (512MB RAM). Runs the FULL 3-layer
# ensemble -- torch is not a runtime dependency at all: layer 3 (the scratch
# classifier) is served by gateway/detectors/classifier_numpy.py, a torch-free
# re-implementation of the trained model's forward pass (verified bit-parity
# in tests/test_classifier_numpy_parity.py). See requirements-render.txt and
# docs/decisions.md for the "why" -- torch was the one dependency too heavy
# for this tier; removing it from serving (not from training) is what made
# full mode fit here.
#
# Supply-chain hygiene (Phase 6, docs/security-scans.md):
#   * the base image is pinned by digest (Dependabot's docker ecosystem proposes updates),
#   * dependencies come from requirements-render.lock and are installed with --require-hashes, so a
#     package whose bytes differ from the recorded SHA-256 cannot be installed,
#   * the service runs as an unprivileged user, and
#   * model artifacts are integrity-checked against models/MANIFEST.sha256 before they are loaded.
FROM python:3.12-slim@sha256:dddfd7e07f9d15aeeca61529320492139d21cac7f0070c00609243e51e4e0016

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

# One package is upgraded past the digest-pinned base: Debian published libpcre2-8-0 10.46-1~deb13u3 (a fixed HIGH, CVE-2026-103111) before the
# python:3.12-slim image was rebuilt with it, and the Trivy image gate fails on a fixed HIGH. Drop this RUN when a refreshed base digest already has u3
# (the gate going green with it removed is the check). Everything else stays as pinned.
RUN apt-get update \
    && apt-get install -y --no-install-recommends --only-upgrade libpcre2-8-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-render.lock .
RUN pip install --require-hashes --no-deps -r requirements-render.lock

# Only what the running service needs -- not scripts/, tests/, docs/, or the
# torch-format model.pt (weights.npz is the numpy-served copy).
COPY gateway/ ./gateway/
COPY project2_agent/ ./project2_agent/
COPY corpus/ ./corpus/
COPY config/ ./config/
COPY models/MANIFEST.sha256 ./models/MANIFEST.sha256
COPY models/embedding_similarity/ ./models/embedding_similarity/
COPY models/scratch_classifier/vocab.json ./models/scratch_classifier/vocab.json
COPY models/scratch_classifier/weights.npz ./models/scratch_classifier/weights.npz

# Unprivileged runtime user. The only place the service writes is logs/ (audit log, approvals database).
RUN useradd --system --no-create-home --uid 10001 --shell /usr/sbin/nologin gateway \
    && mkdir -p /app/logs \
    && chown -R gateway:gateway /app/logs
USER gateway

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
# Full mode by default -- see the header comment above.
ENV GATEWAY_LITE=0
# A pickle or weight file that does not match the manifest is refused, not loaded (gateway/model_integrity.py).
ENV MODEL_INTEGRITY=enforce

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import httpx; httpx.get('http://localhost:8000/health', timeout=3).raise_for_status()" || exit 1

CMD ["sh", "-c", "uvicorn gateway.app:app --host 0.0.0.0 --port ${PORT:-8000}"]
