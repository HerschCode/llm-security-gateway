# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Downloaded dataset cache -- regenerated automatically by
# scripts/prepare_training_data.py on first run (39MB, not worth committing)
data/external/

# Generated training/eval data -- regenerated by scripts/prepare_training_data.py
data/train.csv
data/eval.csv

# Runtime logs -- regenerated by the running gateway, not source
logs/*.jsonl

# OS cruft
.DS_Store

# Trained model artifacts are intentionally NOT ignored -- they're small
# (~7MB total) and kept so the gateway can be run immediately without
# retraining first. See README's "Running it yourself" for the from-scratch
# regeneration path if you want to verify that instead.

.venv/
venv/
